# Supabase projesinin bağlantı bilgileri.
# Bu dosyayı .env.local olarak kopyalayıp doldurun; .env.local commit edilmez.
#
# Değerler Supabase panelinde Project Settings → API altında:
#   NEXT_PUBLIC_SUPABASE_URL      → Project URL
#   NEXT_PUBLIC_SUPABASE_ANON_KEY → anon public key
#
# Boş bırakılırsa panel açılır ama içeriği uygulamaya gömülü bankadan
# salt okunur gösterir; düzenleme kapalı kalır.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
