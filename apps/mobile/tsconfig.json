{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    // `app.config.ts` Expo'nun kendi yükleyicisiyle okunuyor; o
    // yükleyici yalnızca giriş dosyasını derliyor ve komşu bir TS
    // dosyasını ancak uzantısıyla bulabiliyor. Yayma kapalı
    // (`noEmit`) olduğu için bayrağın başka bir etkisi yok.
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["node_modules"]
}
