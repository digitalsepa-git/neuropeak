# Supabase projesinin bağlantı bilgileri.
# Bu dosyayı .env olarak kopyalayıp doldurun; .env commit edilmez.
#
# Değerler Supabase panelinde Project Settings → API altında:
#   EXPO_PUBLIC_SUPABASE_URL      → Project URL
#   EXPO_PUBLIC_SUPABASE_ANON_KEY → anon public key
#
# Boş bırakılırsa uygulama tamamen çevrimdışı çalışır: veriler cihazda
# durur, senkronizasyon beklemeye alınır.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# RevenueCat API anahtarları (Project Settings → API keys).
# Boş bırakılırsa planlar gösterilir ama satın alma yapılamaz; uygulama
# Expo Go'da çalışmaya devam eder.

EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
